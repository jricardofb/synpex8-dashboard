NODE_ENV=development
PORT=3000
HOST=0.0.0.0

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/copytrading
REDIS_URL=redis://localhost:6379
DB_POOL_MAX=20

# Segredos de plataforma distintos. O segredo de cada Master fica cifrado no banco.
# Em NODE_ENV=production valores contendo "change-me" sao recusados.
ADMIN_SECRET=dev-admin-secret-change-me-0002
CLIENT_TOKEN_SECRET=dev-client-token-secret-change-me-0003
SIGNAL_SIGNATURE_MAX_AGE_MS=60000
SIGNAL_RATE_LIMIT_PER_MINUTE=300

# Origens permitidas para a tela do cliente (separadas por virgula). Vazio = sem CORS.
CORS_ORIGINS=

WORKER_CONCURRENCY=10
MAX_EXECUTION_CONCURRENCY=20
MOCK_BROKER_RPS=50
# Em producao o broker MOCK so e registrado com ALLOW_MOCK_BROKER=1
ALLOW_MOCK_BROKER=

# Percentuais de saude nao bloqueiam ordens; a elegibilidade usa freeMargin real do broker.
RISK_RESERVATION_TTL_MS=60000
# SKIP = pula se o volume fixo do robo ficar abaixo do minimo do broker; ROUND_UP = sobe ao minimo (aumenta risco)
LOT_BELOW_MIN_POLICY=SKIP

PENDING_STALE_MS=30000
UNKNOWN_GRACE_MS=120000
POSITION_ABSENCE_GRACE_MS=15000
POSITION_ABSENCE_CONFIRM_MS=6000
RECONCILE_INTERVAL_MS=5000
CLOSE_INTERVAL_MS=2000
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_POLL_INTERVAL_MS=500
# 32-byte base64 key used only to encrypt Master signal secrets at rest.
# Generate: openssl rand -base64 32
MASTER_SECRET_ENCRYPTION_KEY=
