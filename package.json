{
  "name": "copy-trading-engine",
  "version": "0.6.4",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "concurrently \"npm:dev:api\" \"npm:dev:worker\"",
    "dev:api": "tsx watch src/api.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "start:api": "node dist/src/api.js",
    "start:worker": "node dist/src/worker.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration"
  },
  "dependencies": {
    "@fastify/cors": "^10.1.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bullmq": "^5.58.5",
    "dotenv": "^16.4.7",
    "fastify": "^5.12.5",
    "ioredis": "^6.0.0",
    "p-limit": "^6.2.0",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "concurrently": "^9.1.2",
    "prisma": "^7.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "vitest": "^5.0.5"
  }
}
